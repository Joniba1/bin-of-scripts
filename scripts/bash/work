#!/usr/bin/env bash

set -euo pipefail

BODY=""
TITLE=""
BASE=""
POSITIONAL=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--body)
      BODY="$2"
      shift 2
      ;;
    -t|--title)
      TITLE="$2"
      shift 2
      ;;
    --base)
      BASE="$2"
      shift 2
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

# First positional arg is the branch prefix; the rest is the title unless -t was used
PREFIX=""
if [ ${#POSITIONAL[@]} -gt 0 ]; then
  PREFIX="${POSITIONAL[0]}"
  if [ -z "$TITLE" ] && [ ${#POSITIONAL[@]} -gt 1 ]; then
    TITLE="${POSITIONAL[*]:1}"
  fi
fi

if [ -z "$PREFIX" ] || [ -z "$TITLE" ]; then
  echo "Usage: work <prefix> \"Issue title\""
  echo "       work <prefix> -t \"Issue title\" [-b \"Body\"] [--base \"base-branch\"]"
  echo "Example: work feat \"Add upload retry\"  ->  feat/add-upload-retry"
  exit 1
fi

if [ -z "$BASE" ]; then
  BASE=$(git branch --show-current)
fi

echo "Creating issue..."

ISSUE_URL=$(gh issue create \
  --title "$TITLE" \
  --body "$BODY")

ISSUE_NUMBER=$(basename "$ISSUE_URL")

SLUG=$(
  echo "$TITLE" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g' \
    | sed -E 's/^-|-$//g'
)

BRANCH_NAME="${PREFIX}/${SLUG}"

echo "Creating branch: $BRANCH_NAME"

gh issue develop "$ISSUE_NUMBER" --name "$BRANCH_NAME" ${BASE:+--base "$BASE"}

git fetch origin "$BRANCH_NAME"

git checkout "$BRANCH_NAME"

echo
echo "✅ Ready to work"
echo "Issue:  $ISSUE_URL"
echo "Branch: $BRANCH_NAME"